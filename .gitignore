# Test / eye-check video clips — large binaries, per-machine, symlinked. Never in git.

# Model weights (large binaries) — symlinked to the asset repo.
/models
**/models/
*.onnx
*.pt
*.mlpackage/
*.engine

# The operator's LIVE local config edits — ship the template, never commit personal ports/paths.
/readymade.local.conf
/plugins/**/*.local.conf

# Per-rig camera calibration outputs from tools/calibrate_camera.py — device-specific, not shipped.
/camera1.conf
/lens.yaml
/flatfield.png

# Benchmark profiler sample streams — regenerated by every bench run, append-only,
# and large. The CSVs/RESULTS.md they produce ARE committed; these raw traces are not.
/benchmarks/raw/*_samples.csv

# Recordings
/recordings
/recs

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# Logs / scratch
logs/
snapshots/
snap_*.png
snap_*.jpg
tmp/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# GT mask sidecars (SAM3Video output) — large, regenerable; commit only the compact .gt.json
tests/gt/*.masks.npz

# SAM3Video interchange export (intermediate) — only the compact .gt.json is committed
tests/gt/*.sam.json
out/

# Benchmark run logs — one folder per machine, regenerated by benchmarks/run.py.
# The CSV tables analyze.py produces from them ARE committed; the raw logs are not.
/benchmarks/runs/

# Built distribution zips — regenerated by tools/make_dist.py.
/dist/

# vvvv example C# build artifacts + Visual Studio cache
.vs/
examples/vvvv/csharp/**/obj/
examples/vvvv/csharp/**/bin/
